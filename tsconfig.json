{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "~device-info": ["./device-info/index.ts"],
      "~device-info/*": ["./device-info/*"]
    },
    "lib": ["esnext", "dom"],
    "types": ["@dcloudio/types"]
  },
  "include": [
    "**/*.ts",
    "**/*.d.ts",
    "**/*.uvue"
  ],
  "exclude": ["node_modules", "unpackage", "dist"]
}
